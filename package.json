{
  "name": "nhi1-root",
  "version": "0.1.0",
  "private": true,
  "description": "NHI-1 root board: AUA v0.1 (ask / use / replay) for AI and agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "test": "node --test --test-concurrency=4 --test-timeout=180000 tests/*.test.ts",
    "build:site": "node tools/build-site.ts",
    "local-board": "node tools/local-board.ts",
    "smoke": "node tools/smoke.ts && node tools/smoke-mem.ts",
    "accept": "node tools/acceptance.ts",
    "mcp": "node mcp/server.ts",
    "mcp:http": "node mcp/server.ts --http 8787",
    "export": "node tools/export-local.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15"
  }
}
